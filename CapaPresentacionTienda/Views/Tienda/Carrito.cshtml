
@{
    ViewBag.Title = "Carrito";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-body">

                    <div class="row">

                        <!--Detalle Producto-->
                        <div class="col-sm-9">

                            <div class="me-2">

                                <div class="d-flex justify-content-between">
                                    <h5 class="ms-2 mt-2">Detalle Carrito</h5>
                                    <a class="btn btn-primary" href="@Url.Action("Index", "Tienda")"><i class="fas fa-cart-plus"></i> Seguir Comprando</a>
                                </div>

                                <hr class="mt-2 mb-2"/>

                                <div id="productos-carrito">

                                    <div class="card-body">

                                        <div class="row">

                                            <div class="col-sm-2 align-self-center d-flex justify-content-center">
                                                <img class="rounded" src="https://dummyimage.com/450x300/dee2e6/6c757d.jpg" style="width:100px;height:100px"/>
                                            </div>

                                            <div class="col-sm-4 align-self-center">
                                                <span class="font-wight-bold d-block">Marca</span>
                                                <span>Nombre Producto</span>
                                            </div>

                                            <div class="col-sm-2 align-self-center">
                                                <span>Precio : S/. 1500</span>
                                            </div>

                                            <div class="col-sm-2 align-self-center">
                                                
                                                <div class="d-flex">

                                                    <button>
                                                        <i class="fas fa-minus"></i>
                                                    </button>
                                                    <input class="form-control input-cantidad p-1 text-center rounded-0"/>
                                                    <button class="btn btn-outline-secondary btn-sumar rounded-0">
                                                        <i class="fas fa-plus"></i>
                                                    </button>
                                                </div>

                                            </div>

                                            <div class="col-sm-2 align-self-center">

                                                <button class="btn btn-outline-danger btn-eliminar"><i class="far fa-trash-alt"></i> Eliminar</button>
                                            </div>
                                        </div>

                                    </div>

                                </div>

                            </div>
                            
                        </div>

                        <!--Detalle Producto-->
                        <div class="col-sm-3">
                            <div class="card">
                                <div class="card-body bg-light">
                                    <h5 class="card-title">Detalle Envio</h5>
                                    
                                    <form>
                                        <div class="mb-2">
                                            <label for="cboprovincia" class="form-label">Provincia: </label>
                                            <select class="form-select form-select-sm" id="cboprovincia"></select>
                                        </div>
                                        <div class="mb-2">
                                            <label for="cbodepartamento" class="form-label">Departamento: </label>
                                            <select class="form-select form-select-sm" id="cbodepartamento"></select>
                                        </div>
                                        <div class="mb-2">
                                            <label for="cbolocalidad" class="form-label">Localidad: </label>
                                            <select class="form-select form-select-sm" id="cbolocalidad"></select>
                                        </div>
                                        <div class="mb-2">
                                            <label for="exampleInputEmail" class="form-label">Nombre Contacto: </label>
                                            <input type="text" class="form-control form-control-sm" id="txtnombrecontacto" autocomplete="off" />
                                        </div>
                                        <div class="mb-2">
                                            <label for="txtdireccion" class="form-label">Dirección: </label>
                                            <input type="text" class="form-control form-control-sm" id="txtdireccion" autocomplete="off" />
                                        </div>
                                        <div class="mb-2">
                                            <label for="txttelefono" class="form-label">Teléfono: </label>
                                            <input type="text" class="form-control form-control-sm" id="txttelefono" autocomplete="off" />
                                        </div>
                                        <div class="d-grid">
                                            <button class="btn btn-success" type="button" onclick="RealizarPago()">
                                                <i class="fab fa-paypal"></i> Procesar Pago
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>

            $(document).ready(function () {
                ListarProvincia();
            });

            function ListarProvincia() {
                $("#cboprovincia").html("");
                $("<option>").attr({ "value": "00", "disabled": "disabled", "selected": "true" }).text("Seleccionar").appendTo("#cboprovincia");

                $.ajax({
                    url: '@Url.Action("ObtenerProvincia", "Tienda")',
                    type: "POST",
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        if (data.lista != null) {
                            $.each(data.lista, function (i, item) {
                                $("<option>").attr("value", item.IdProvincia).text(item.Descripcion).appendTo("#cboprovincia");
                            });
                        }
                    }
                });
            }

            $("#cboprovincia").on("change", function () {
                let idProvincia = $(this).val();
                ListarDepartamento(idProvincia);
            });

            function ListarDepartamento(idProvincia) {
                $("#cbodepartamento").html("");
                $("<option>").attr({ "value": "00", "disabled": "disabled", "selected": "true" }).text("Seleccionar").appendTo("#cbodepartamento");

                $.ajax({
                    url: '@Url.Action("ObtenerDepartamento", "Tienda")',
                    type: "POST",
                    data: JSON.stringify({ idProvincia: idProvincia }),
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        if (data.lista != null) {
                            $.each(data.lista, function (i, item) {
                                $("<option>").attr("value", item.IdDepartamento).text(item.Descripcion).appendTo("#cbodepartamento");
                            });
                        }
                    }
                });
            }

            $("#cbodepartamento").on("change", function () {
                let idDepartamento = $(this).val();
                ListarLocalidad(idDepartamento);
            });

            function ListarLocalidad(idDepartamento) {
                $("#cbolocalidad").html("");
                $("<option>").attr({ "value": "00", "disabled": "disabled", "selected": "true" }).text("Seleccionar").appendTo("#cbolocalidad");

                $.ajax({
                    url: '@Url.Action("ObtenerLocalidad", "Tienda")',
                    type: "POST",
                    data: JSON.stringify({ iddepartamento: idDepartamento }),
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        if (data.lista != null) {
                            $.each(data.lista, function (i, item) {
                                $("<option>").attr("value", item.IdLocalidad).text(item.Descripcion).appendTo("#cbolocalidad");
                            });
                        }
                    }
                });
            }
    </script>
    }